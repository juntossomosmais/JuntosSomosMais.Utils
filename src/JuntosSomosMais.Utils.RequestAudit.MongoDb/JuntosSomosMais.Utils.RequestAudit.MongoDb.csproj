<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JuntosSomosMais.Utils.RequestAudit.MongoDb</RootNamespace>
    <Description>MongoDB provider of RequestAudit: one document per audited HTTP request, with optional expiration through a TTL index.</Description>
    <PackageId>JuntosSomosMais.Utils.RequestAudit.MongoDb</PackageId>
    <PackageTags>audit request logging aspnetcore mongodb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <MinVerTagPrefix>requestaudit/v</MinVerTagPrefix>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against the 2.x line, which ships MongoDB.Driver.Core as its own assembly; 3.0 merged it into
         MongoDB.Driver, so this build would fail to load there. The upper bound makes NuGet warn at install time. -->
    <PackageReference Include="MongoDB.Driver" Version="[2.29.0,3.0.0)" />
    <!-- MongoDB.Driver 2.29.0 resolves Snappier 1.0.0, affected by CVE-2026-44302 (infinite loop on malformed
         snappy frames). Pinned to the fixed version until the driver floor moves past it. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JuntosSomosMais.Utils.RequestAudit\JuntosSomosMais.Utils.RequestAudit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
