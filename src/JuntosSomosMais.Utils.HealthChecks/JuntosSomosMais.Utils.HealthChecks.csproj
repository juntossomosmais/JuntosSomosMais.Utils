<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JuntosSomosMais.Utils.HealthChecks</RootNamespace>
    <Description>Reusable health checks for SQL Server, Redis, RabbitMQ, Hangfire, Azure Blob Storage, Azure Service Bus, MongoDB, Elasticsearch, and a standardized JSON response writer.</Description>
    <PackageId>JuntosSomosMais.Utils.HealthChecks</PackageId>
    <PackageTags>healthcheck aspnetcore sqlserver redis rabbitmq hangfire azureblobstorage azureservicebus mongodb elasticsearch</PackageTags>
    <MinVerTagPrefix>healthchecks/v</MinVerTagPrefix>
    <!-- Ships the XML docs so IntelliSense shows them. Most public members have none yet, hence no CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JuntosSomosMais.Utils.HealthChecks.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit floors, kept at the versions of the last published package: a floating version (7.*) is written
         to the nuspec as whatever it resolved to, so a lock file refresh would silently raise the minimum every
         consumer is forced onto. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <!-- Built against 2.x, where MongoDB.Driver.Core is a separate assembly (3.0 merged it), so only the MongoDB
         check breaks on 3.x. No upper bound on purpose: a capped range makes restore fail (NU1107) for services
         that get 3.x transitively and never register the MongoDB check. -->
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <PackageReference Include="NRedisStack" Version="0.13.3" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <!-- Transitive floors with known vulnerabilities, pinned to the fixed versions until the parents move past them:
         MongoDB.Driver 2.x resolves Snappier 1.0.0 (GHSA-pggp-6c3x-2xmx) and Hangfire.Core 1.8 resolves
         Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
</Project>
